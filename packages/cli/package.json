{
  "name": "@teammate/cli",
  "version": "0.1.0",
  "description": "Teammate CLI \u2014 agent communication tool for Teammate",
  "type": "module",
  "bin": {
    "teammate": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "teammate",
    "codex",
    "ai",
    "agent",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "@teammate/local-client": "workspace:*",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@teammate/shared": "workspace:*"
  }
}
