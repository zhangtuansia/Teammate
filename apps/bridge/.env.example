# Teammate agent runtime — local development configuration
#
# The desktop app starts its bundled runtime automatically. To run the optional
# remote runtime from this repository, use:
#   pnpm dev:runtime -- --api-key <your-machine-api-key>
#
# These env vars are only used when running the runtime from source (pnpm dev:runtime)
# or when self-hosting Teammate. Everything except TEAMMATE_AGENTS_DIR can be
# overridden by the corresponding CLI flag.

TEAMMATE_API_KEY=tm_your_key_here
TEAMMATE_SERVER_URL=https://your-teammate.example
TEAMMATE_AGENTS_DIR=~/.teammate/agents
